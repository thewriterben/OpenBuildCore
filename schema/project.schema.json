{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openbuildcore/project.schema.json",
  "title": "Project",
  "description": "Something a person could build. Requirements are either a specific part or a capability any part may provide, each with a quantity.",
  "type": "object",
  "required": ["schema_version", "id", "name", "description", "requires"],
  "properties": {
    "schema_version": { "const": 0 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
    "requires": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "oneOf": [
          { "required": ["part_id"], "not": { "required": ["capability"] } },
          { "required": ["capability"], "not": { "required": ["part_id"] } }
        ],
        "properties": {
          "part_id": {
            "type": "string",
            "description": "Canonical OpenPartsCore id. Must resolve.",
            "pattern": "^(boards|electronic|mechanical|material)/[a-z0-9][a-z0-9._-]*$"
          },
          "capability": {
            "type": "string",
            "description": "A capability token. Must be provided by at least one registry part, or the project can never be built."
          },
          "qty": { "type": "integer", "minimum": 1 },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "related_designs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
